<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="AZ Tech Tuesday is Arizona's weekly tech and business happy hour and networking mixer. Every Tuesday, 5:30–7:30 PM. Sponsors and members welcome.">
<meta property="og:title" content="AZ Tech Tuesday">
<meta property="og:description" content="Arizona's weekly tech & business happy hour and networking mixer. Every Tuesday, 5:30–7:30 PM.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://aztechtuesday.com">
<link rel="canonical" href="https://aztechtuesday.com">
<link rel="icon" type="image/svg+xml" href="/img/logo-small.svg">
<link rel="preload" as="image" href="/img/logo.svg">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
:root{--bs-warning:#F5B335;--bs-warning-rgb:245,179,53}
[data-bs-theme="dark"] .logo-invert{filter:invert(1)}
</style>
</head>
<body>

<nav class="navbar navbar-expand-lg sticky-top border-bottom border-secondary-subtle bg-body">
  <div class="container">
    <a class="navbar-brand fw-bold d-flex align-items-center" href="/"><img src="/img/logo-small.svg" alt="" width="32" height="32" class="me-2 logo-invert">AZ Tech Tuesday</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
        <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="#events">Events</a></li>
        <li class="nav-item"><a class="nav-link" href="#members">Members</a></li>
        <li class="nav-item"><a class="nav-link" href="#sponsors">Sponsors</a></li>
        <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
        <li class="nav-item">
          <button id="themeToggle" class="btn btn-outline-secondary btn-sm rounded-circle ms-lg-2" type="button" aria-label="Toggle theme">
            <i class="bi bi-sun"></i>
          </button>
        </li>
        <li class="nav-item"><a class="btn btn-warning fw-semibold ms-lg-2" href="#rsvp">RSVP</a></li>
      </ul>
    </div>
  </div>
</nav>

{{ content | safe }}

<footer class="py-5 border-top border-secondary-subtle">
  <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3 text-body-secondary small">
    <span class="fw-bold text-body d-inline-flex align-items-center"><img src="/img/logo-small.svg" alt="" width="24" height="24" class="me-2 logo-invert">AZ Tech Tuesday</span>
    <a href="mailto:toni@xyzgalaxy.com" class="text-body-secondary text-decoration-none">toni@xyzgalaxy.com</a>
    <span>Every Tuesday · 5:30–7:30 PM · Arizona</span>
    <span>© AZ Tech Tuesday 2026</span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/site.js"></script>
</body>
</html>
